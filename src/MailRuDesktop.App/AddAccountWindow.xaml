<Window x:Class="MailRuDesktop.App.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить аккаунт Mail.ru"
        Icon="{StaticResource AppIcon}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppDialogBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="20" Width="390">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Логин Mail.ru"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="LoginTextBox"
                 Grid.Row="1"
                 Padding="8"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="Пароль"
                   Margin="0,0,0,5"/>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <PasswordBox x:Name="PasswordBox"
                         Grid.Row="0"
                         Padding="8"
                         Margin="0,0,0,14"/>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="100"
                        Margin="0,0,8,0"
                        Padding="10,7"
                        IsCancel="True"
                        Content="Отмена"/>
                <Button Width="120"
                        Padding="10,7"
                        IsDefault="True"
                        Click="AddButton_Click"
                        Content="Добавить"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
