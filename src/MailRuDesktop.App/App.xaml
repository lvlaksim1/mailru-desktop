<Application x:Class="MailRuDesktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ThemeStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme palette. ThemeManager replaces these resources atomically. -->
            <SolidColorBrush x:Key="AppWindowBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppPanelBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppControlBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppControlHoverBrush" Color="#F3F5F7"/>
            <SolidColorBrush x:Key="AppControlPressedBrush" Color="#E8EBEF"/>
            <SolidColorBrush x:Key="AppTextBrush" Color="#202124"/>
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#70757A"/>
            <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#9AA0A6"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D6DCE5"/>
            <SolidColorBrush x:Key="AppSelectionBrush" Color="#DCEBFA"/>
            <SolidColorBrush x:Key="AppSelectionTextBrush" Color="#202124"/>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0D6EFD"/>
            <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF"/>

            <!-- Owner-approved cloud + envelope mark. -->
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#0D6EFD"
                                         Geometry="M 12,43 C 5,43 2,38 2,32 C 2,26 7,21 13,21 C 16,11 25,5 35,5 C 47,5 56,14 57,25 C 63,25 68,30 68,36 C 68,41 64,45 58,45 L 12,45 Z"/>
                        <GeometryDrawing Brush="#24C7F2"
                                         Geometry="M 18,24 C 21,15 29,10 38,10 C 47,10 53,16 55,25 C 50,21 45,19 39,19 C 31,19 24,21 18,24 Z"/>
                        <GeometryDrawing Brush="#FFFFFF"
                                         Geometry="M 15,27 L 55,27 C 58,27 60,29 60,32 L 60,49 C 60,52 58,54 55,54 L 15,54 C 12,54 10,52 10,49 L 10,32 C 10,29 12,27 15,27 Z"/>
                        <GeometryDrawing Brush="#D9EEFF"
                                         Geometry="M 11,50 L 28,37 L 34,42 C 35,43 36,43 37,42 L 43,37 L 59,50 C 58,52 57,53 54,53 L 16,53 C 14,53 12,52 11,50 Z"/>
                        <GeometryDrawing Brush="#0877E8"
                                         Geometry="M 11,30 L 33,44 C 35,45 36,45 38,44 L 59,30 L 59,34 L 39,47 C 36,49 34,49 31,47 L 11,34 Z"/>
                        <GeometryDrawing Brush="#FFFFFF"
                                         Geometry="M 12,29 L 33,41 C 35,42 36,42 38,41 L 58,29 C 57,28 56,28 54,28 L 16,28 C 14,28 13,28 12,29 Z"/>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
