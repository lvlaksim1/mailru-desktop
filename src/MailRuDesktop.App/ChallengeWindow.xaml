<Window x:Class="MailRuDesktop.App.ChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailRu Desktop · Проверка Mail.ru"
        Height="720" Width="980"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Background="{DynamicResource AppPanelBrush}">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Дополнительная проверка Mail.ru"/>
                <TextBlock x:Name="HintText"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser"/>

            <Border x:Name="ImageCaptchaPanel"
                    Visibility="Collapsed"
                    Padding="24"
                    Background="{DynamicResource AppPanelBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="430">
                    <TextBlock Text="Введите символы с изображения"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"
                               HorizontalAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Padding="12"
                            Background="White">
                        <Image x:Name="CaptchaImage"
                               MaxWidth="400"
                               MaxHeight="220"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBox x:Name="CaptchaAnswerTextBox"
                             Margin="0,16,0,0"
                             Padding="10"
                             FontSize="17"
                             HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="12">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#555"
                       Text="Загрузка проверки..."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ContinueButton"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="ContinueButton_Click"
                        Content="Отправить"/>
                <Button Padding="14,7"
                        IsCancel="True"
                        Content="Отмена"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
