<Window x:Class="MailRuDesktop.App.ChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailRu Desktop · Проверка Mail.ru"
        Height="720" Width="980"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Background="#F4F6F8">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Дополнительная проверка Mail.ru"/>
                <TextBlock x:Name="HintText"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="#555"/>
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>

        <DockPanel Grid.Row="2" Margin="12">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#555"
                       Text="Загрузка проверки..."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ContinueButton"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="ContinueButton_Click"
                        Content="Продолжить"/>
                <Button Padding="14,7"
                        IsCancel="True"
                        Content="Отмена"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>