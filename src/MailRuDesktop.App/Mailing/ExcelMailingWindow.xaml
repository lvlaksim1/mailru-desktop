<Window x:Class="MailRuDesktop.App.Mailing.ExcelMailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рассылки Excel — подготовка"
        Width="1280" Height="880" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="125"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="155" MinHeight="90"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Рассылки Excel"/>
            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"
                       Text="Подготовьте письма, проверьте расписание и подтвердите постановку на сервер. Подтверждённые задания отмечаются в Excel."/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="Профиль:" Margin="0,0,6,0"/>
            <ComboBox x:Name="ProfileCombo" Width="220" Margin="0,0,8,0"
                      DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged"/>
            <Button Content="Создать" Padding="10,5" Margin="0,0,6,0" Click="CreateProfile_Click"/>
            <Button Content="Копия" Padding="10,5" Margin="0,0,6,0" Click="CopyProfile_Click"/>
            <Button Content="Переименовать" Padding="10,5" Margin="0,0,6,0" Click="RenameProfile_Click"/>
            <Button Content="Удалить" Padding="10,5" Margin="0,0,6,0" Click="DeleteProfile_Click"/>
            <Button x:Name="SaveProfileButton" Content="Сохранить профиль" Padding="10,5"
                    FontWeight="SemiBold" Click="SaveProfile_Click"/>
            <TextBlock x:Name="DirtyText" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
        </WrapPanel>
        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Один шаблон рассылки"/>
                    <ComboBox x:Name="TemplateCombo" Margin="0,4,0,8" DisplayMemberPath="Name"
                              SelectionChanged="FieldChanged"/>
                    <TextBlock Text="Начало рассылки (общее для всех отправителей)"/>
                    <WrapPanel Margin="0,4,0,8">
                        <DatePicker x:Name="StartDatePicker" Width="145"
                                    SelectedDateChanged="DateChanged"/>
                        <TextBox x:Name="StartTimeBox" Width="76" Margin="6,0,0,0" Padding="6"
                                 TextChanged="FieldChangedText"/>
                        <TextBlock x:Name="TimeZoneText" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="Интервал одного отправителя, секунд"/>
                    <TextBox x:Name="IntervalBox" Width="90" HorizontalAlignment="Left"
                             Padding="6" Margin="0,4,0,0" TextChanged="FieldChangedText"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Аккаунты: выберите отправителей и задайте квоты" Margin="0,0,0,4"/>
                    <DataGrid x:Name="SenderGrid" Height="124" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              CellEditEnding="SenderGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Выбран" Width="72"
                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Авторизованный аккаунт" Width="*"
                                Binding="{Binding Login}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Доступность" Width="112"
                                Binding="{Binding Availability}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Писем" Width="82"
                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Thumb x:Name="SenderGridResizeThumb" Cursor="SizeNS"
                           Height="8" Margin="0,3,0,0"
                           Background="{DynamicResource AppBorderBrush}"
                           ToolTip="Потяните вверх или вниз, чтобы изменить высоту списка аккаунтов"
                           DragDelta="SenderGridResizeThumb_DragDelta"
                           DragCompleted="SenderGridResizeThumb_DragCompleted"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="↑ Выше" Padding="7,3" Margin="0,0,6,0" Click="MoveSenderUp_Click"/>
                        <Button Content="↓ Ниже" Padding="7,3" Click="MoveSenderDown_Click"/>
                        <TextBlock x:Name="QuotaSummaryText" VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Тема письма (допустимы {Название_организации}, {ИНН_организации}, {Регион})"/>
            <TextBox x:Name="SubjectBox" Margin="0,4,0,9" Padding="6"
                     TextChanged="FieldChangedText"/>
            <WrapPanel>
                <Button Content="Найти открытые книги Excel" Padding="10,6"
                        Margin="0,0,8,0" Click="FindBooks_Click"/>
                <ComboBox x:Name="BookCombo" Width="360" Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName" SelectionChanged="BookCombo_SelectionChanged"/>
                <TextBlock Text="Лист:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SheetCombo" Width="175" Margin="0,0,8,0"/>
                <Button x:Name="PrepareButton" Content="Проверить и подготовить" Padding="12,6"
                        FontWeight="SemiBold" Click="Prepare_Click"/>
                <Button x:Name="StopButton" Content="Прервать подготовку"
                        Visibility="Collapsed" Padding="9,6" Margin="8,0,0,0"
                        Click="Stop_Click"/>
            </WrapPanel>
            <TextBlock x:Name="BookPathText" Margin="0,5,0,0" FontSize="11"
                       Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="При подготовке ИНН запрашиваются в справочнике организаций; при ошибке источник не заменяется данными Excel."
                       Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"
                       Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Text="Выберите профиль, книгу и лист. Никаких писем без отдельного этапа отправки не будет."/>
            <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="RetryOrganizationButton" Content="Повторить поиск по ИНН"
                        Padding="9,5" Margin="0,0,6,0" Click="RetryOrganization_Click"/>
                <Button x:Name="ManualOrganizationButton" Content="Указать название вручную"
                        Padding="9,5" Margin="0,0,6,0" Click="ManualOrganization_Click"/>
                <Button x:Name="IncludeOrganizationButton" Content="Вернуть в рассылку"
                        Padding="9,5" Click="IncludeOrganization_Click"/>
            </WrapPanel>
            <WrapPanel Margin="0,7,0,0">
                <Button x:Name="StartMailingButton" Content="Запустить рассылку"
                        Padding="10,5" Margin="0,0,6,0" IsEnabled="False" Click="StartMailing_Click"/>
                <Button x:Name="PauseMailingButton" Content="Пауза"
                        Padding="9,5" Margin="0,0,6,0" IsEnabled="False" Click="PauseMailing_Click"/>
                <Button x:Name="ResumeMailingButton" Content="Продолжить"
                        Padding="9,5" Margin="0,0,6,0" Click="ResumeMailing_Click"/>
                <Button x:Name="StopMailingButton" Content="Остановить новые задания"
                        Padding="9,5" Margin="0,0,6,0" IsEnabled="False" Click="StopMailing_Click"/>
                <Button x:Name="RetryExcelWriteButton" Content="Повторить запись в Excel"
                        Padding="9,5" Margin="0,0,8,0" Click="RetryExcelWrite_Click"/>
                <TextBlock Text="История:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="RunHistoryCombo" Width="270"
                          DisplayMemberPath="Display" SelectionChanged="RunHistoryCombo_SelectionChanged"/>
            </WrapPanel>
            <TextBlock x:Name="RunStatusText" Margin="0,4,0,0" TextWrapping="Wrap"/>

        </StackPanel>
        <DataGrid x:Name="PreviewGrid" Grid.Row="5" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="PreviewGrid_SelectionChanged"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Resources>
                <Style x:Key="PreviewGridSelectableTextStyle" TargetType="{x:Type TextBox}">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="3,2"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewGridText_PreviewMouseLeftButtonDown"/>
                    <EventSetter Event="MouseDoubleClick" Handler="PreviewGridText_MouseDoubleClick"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Строка" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding RowNumber, Mode=OneWay}" ToolTip="{Binding RowNumber}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Получатель" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding Email, Mode=OneWay}" ToolTip="{Binding Email}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ИНН" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding Inn, Mode=OneWay}" ToolTip="{Binding Inn}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Организация" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding Organization, Mode=OneWay}" ToolTip="{Binding Organization}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Отправитель" Width="185">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding Sender, Mode=OneWay}" ToolTip="{Binding Sender}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Назначено" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding ScheduledText, Mode=OneWay}" ToolTip="{Binding ScheduledText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Состояние" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding DisplayStatus, Mode=OneWay}" ToolTip="{Binding DisplayStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Причина / примечание" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource PreviewGridSelectableTextStyle}"
                                     Text="{Binding Reason, Mode=OneWay}" ToolTip="{Binding Reason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter x:Name="MessagePreviewSplitter" Grid.Row="6" Height="7" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                      Background="{DynamicResource AppBorderBrush}"
                      ToolTip="Перетащите, чтобы изменить высоту просмотра письма"/>
        <Grid Grid.Row="7" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Выбранное письмо: тема и форматированный текст"/>
            <TextBox x:Name="MessagePreviewSubject" Grid.Row="1" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent"
                     FontWeight="SemiBold" Margin="0,4,0,2"
                     TextWrapping="Wrap" Padding="4"/>
            <FlowDocumentScrollViewer x:Name="MessagePreviewDocument" Grid.Row="2"
                    Margin="0,2,0,0" Padding="4" IsSelectionEnabled="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Background="{DynamicResource AppWindowBrush}"/>
        </Grid>
    </Grid>
</Window>
