<Window x:Class="MailRuDesktop.App.Mailing.ExcelMailingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рассылки Excel — отправка"
        Width="1200" Height="690" MinWidth="920" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Рассылки Excel"/>
            <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"
                       Text="Выберите книгу, лист и первую строку. Кнопка «Отправить» сразу ставит письма на отложенную отправку Mail.ru; подтверждённые задания отмечаются в Excel."/>
        </StackPanel>
        <WrapPanel x:Name="ProfileControls" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="Профиль:" Margin="0,0,6,0"/>
            <ComboBox x:Name="ProfileCombo" Width="220" Margin="0,0,8,0"
                      DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged"/>
            <Button Content="Создать" Padding="10,5" Margin="0,0,6,0" Click="CreateProfile_Click"/>
            <Button Content="Копия" Padding="10,5" Margin="0,0,6,0" Click="CopyProfile_Click"/>
            <Button Content="Переименовать" Padding="10,5" Margin="0,0,6,0" Click="RenameProfile_Click"/>
            <Button Content="Удалить" Padding="10,5" Margin="0,0,6,0" Click="DeleteProfile_Click"/>
            <Button x:Name="SaveProfileButton" Content="Сохранить профиль" Padding="10,5"
                    FontWeight="SemiBold" Click="SaveProfile_Click"/>
            <TextBlock x:Name="DirtyText" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
        </WrapPanel>
        <Border x:Name="OptionsBorder" Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Один шаблон рассылки"/>
                    <ComboBox x:Name="TemplateCombo" Margin="0,4,0,8" DisplayMemberPath="Name"
                              SelectionChanged="FieldChanged"/>
                    <TextBlock Text="Начало рассылки (общее для всех отправителей)"/>
                    <WrapPanel Margin="0,4,0,8">
                        <DatePicker x:Name="StartDatePicker" Width="145"
                                    SelectedDateChanged="DateChanged"/>
                        <TextBox x:Name="StartTimeBox" Width="76" Margin="6,0,0,0" Padding="6"
                                 TextChanged="FieldChangedText"/>
                        <TextBlock x:Name="TimeZoneText" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="Интервал одного отправителя, секунд"/>
                    <TextBox x:Name="IntervalBox" Width="90" HorizontalAlignment="Left"
                             Padding="6" Margin="0,4,0,0" TextChanged="FieldChangedText"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Аккаунты: выберите отправителей и задайте квоты" Margin="0,0,0,4"/>
                    <DataGrid x:Name="SenderGrid" Height="124" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              CellEditEnding="SenderGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Выбран" Width="72"
                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Авторизованный аккаунт" Width="*"
                                Binding="{Binding Login}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Доступность" Width="112"
                                Binding="{Binding Availability}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Квота" Width="76"
                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Отправлено" Width="92"
                                Binding="{Binding SentCount}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Thumb x:Name="SenderGridResizeThumb" Cursor="SizeNS"
                           Height="8" Margin="0,3,0,0"
                           Background="{DynamicResource AppBorderBrush}"
                           ToolTip="Потяните вверх или вниз, чтобы изменить высоту списка аккаунтов"
                           DragDelta="SenderGridResizeThumb_DragDelta"
                           DragCompleted="SenderGridResizeThumb_DragCompleted"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="↑ Выше" Padding="7,3" Margin="0,0,6,0" Click="MoveSenderUp_Click"/>
                        <Button Content="↓ Ниже" Padding="7,3" Click="MoveSenderDown_Click"/>
                        <Button x:Name="ResetSenderCountersButton" Content="Обнулить счётчики"
                                Padding="7,3" Margin="8,0,0,0"
                                Click="ResetSenderCounters_Click"/>
                        <TextBlock x:Name="QuotaSummaryText" VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Тема письма (допустимы {Название_организации}, {ИНН_организации}, {Регион})"/>
            <TextBox Grid.Row="1" x:Name="SubjectBox" Margin="0,4,0,9" Padding="6"
                     TextChanged="FieldChangedText"/>
            <WrapPanel Grid.Row="2">
                <ComboBox x:Name="BookCombo" Width="360" Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName"
                          DropDownOpened="BookCombo_DropDownOpened"
                          SelectionChanged="BookCombo_SelectionChanged"/>
                <TextBlock Text="Лист:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SheetCombo" Width="175" Margin="0,0,8,0"/>
                <Button x:Name="SendButton" Content="Отправить" Padding="12,6"
                        FontWeight="SemiBold" Click="Send_Click"/>
                <Button x:Name="StopButton" Content="Прервать" Padding="12,6"
                        Margin="6,0,0,0" IsEnabled="False" Click="StopMailing_Click"/>
                <CheckBox x:Name="JournalEnabledCheck" Content="Записывать в журнал"
                          Margin="14,0,10,0" VerticalAlignment="Center"
                          IsChecked="True" Checked="JournalEnabled_Changed"
                          Unchecked="JournalEnabled_Changed"/>
                <Button x:Name="OpenJournalButton" Content="Открыть журнал"
                        Padding="10,6" Click="OpenJournal_Click"/>
            </WrapPanel>
            <TextBlock Grid.Row="3" x:Name="BookPathText" Margin="0,5,0,0" FontSize="11"
                       Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="4" Text="Если справочник не определит организацию по ИНН, будет использовано «Наименование работодателя» из Excel."
                       Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"
                       Margin="0,3,0,0"/>
            <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,7,0,7" TextWrapping="Wrap"
                       Text="Готово к отправке. Проверьте профиль и исходную строку Excel."/>
            <TextBox Grid.Row="6" x:Name="ExecutionLogTextBox" IsReadOnly="True"
                     IsUndoEnabled="False" MinHeight="65" Padding="6"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
    </Grid>
</Window>
