<Window x:Class="MailRuDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailRu Desktop"
        Icon="{StaticResource AppIcon}"
        Height="820" Width="1360"
        MinHeight="680" MinWidth="1080">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MailRu Desktop"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="LoginComboBox"
                      Grid.Column="0"
                      Margin="0,0,10,0"
                      Padding="6"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      SelectionChanged="LoginComboBox_SelectionChanged"
                      ToolTip="Логин Mail.ru. Сохранённые авторизации доступны в списке."/>

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         Padding="8"
                         ToolTip="Пароль не сохраняется. Сохраняются только защищённые Windows токены и сессия."/>

            <Button x:Name="AuthenticateButton"
                    Grid.Column="2"
                    Padding="18,8"
                    Click="AuthenticateButton_Click"
                    Content="Войти"/>

            <TextBlock x:Name="AuthStatusText"
                       Grid.Column="3"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Text="Не авторизовано"/>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2">
            <TabItem x:Name="MailTab" Header="Почта">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RefreshFolderButton"
                                Grid.Column="0"
                                Padding="16,8"
                                Click="RefreshFolderButton_Click"
                                Content="Обновить"/>

                        <ComboBox x:Name="MoveFolderComboBox"
                                  Grid.Column="1"
                                  Width="190"
                                  Margin="10,0,0,0"
                                  DisplayMemberPath="Name"
                                  ToolTip="Папка назначения"/>

                        <Button x:Name="MoveMessageButton"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                Padding="12,8"
                                Click="MoveMessageButton_Click"
                                Content="Переместить"/>

                        <Button x:Name="TrashMessageButton"
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Padding="12,8"
                                Click="TrashMessageButton_Click"
                                Content="В корзину"/>

                        <Button x:Name="DeleteMessageButton"
                                Grid.Column="4"
                                Margin="6,0,0,0"
                                Padding="12,8"
                                Click="DeleteMessageButton_Click"
                                Content="Удалить навсегда"/>

                        <TextBlock x:Name="FolderStatusText"
                                   Grid.Column="5"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Авторизуйтесь для загрузки почты"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="6,4,6,10"
                                           FontWeight="SemiBold"
                                           Text="Папки"/>
                                <ListBox x:Name="FolderListBox"
                                         BorderThickness="0"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="FolderListBox_SelectionChanged"/>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <DataGrid x:Name="MessagesGrid"
                                  Grid.Column="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionChanged="MessagesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Width="28" Binding="{Binding UnreadMark}"/>
                                <DataGridTextColumn Header="Отправитель" Width="170" Binding="{Binding SenderDisplay}"/>
                                <DataGridTextColumn Header="Тема" Width="*" Binding="{Binding Subject}"/>
                                <DataGridTextColumn Header="Дата" Width="125" Binding="{Binding DateDisplay}"/>
                                <DataGridTextColumn Header="" Width="32" Binding="{Binding AttachmentMark}"/>
                                <DataGridTextColumn Header="" Width="32" Binding="{Binding FlagMark}"/>
                                <DataGridTextColumn Header="Размер" Width="80" Binding="{Binding SizeDisplay}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="3"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <Border Grid.Column="4"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="SelectedSubjectText"
                                           Grid.Row="0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="Выберите письмо"/>

                                <TextBlock x:Name="SelectedSenderText"
                                           Grid.Row="1"
                                           Margin="0,7,0,0"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                <StackPanel Grid.Row="2" Margin="0,3,0,8">
                                    <TextBlock x:Name="SelectedDateText" Foreground="Gray"/>
                                    <TextBlock x:Name="SelectedMetaText"
                                               Margin="0,2,0,0"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Row="3"
                                        BorderBrush="#E3E6EA"
                                        BorderThickness="1"
                                        Margin="0,0,0,8">
                                    <wv2:WebView2 x:Name="MessageWebView"/>
                                </Border>

                                <TextBlock Grid.Row="4"
                                           FontWeight="SemiBold"
                                           Text="Вложения"/>

                                <ListBox x:Name="IncomingAttachmentsListBox"
                                         Grid.Row="5"
                                         Margin="0,5,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayMeta}"
                                                           Foreground="Gray"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button x:Name="DownloadAttachmentButton"
                                        Grid.Row="6"
                                        Margin="0,7,0,0"
                                        Padding="12,7"
                                        HorizontalAlignment="Left"
                                        Click="DownloadAttachmentButton_Click"
                                        Content="Скачать выбранное вложение"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="2"
                              Margin="0,10,0,0"
                              Header="Диагностика · raw JSON / auth">
                        <TextBox x:Name="ResponseTextBox"
                                 Height="150"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"/>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" Header="Поиск">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Text="От:"/>
                        <TextBox x:Name="SearchSenderTextBox" Width="180" Margin="6,0,12,0" Padding="6"/>
                        <TextBlock VerticalAlignment="Center" Text="Тема:"/>
                        <TextBox x:Name="SearchSubjectTextBox" Width="180" Margin="6,0,12,0" Padding="6"/>
                        <TextBlock VerticalAlignment="Center" Text="Текст:"/>
                        <TextBox x:Name="SearchQueryTextBox" Width="220" Margin="6,0,12,0" Padding="6"/>
                        <CheckBox x:Name="SearchAttachmentsCheckBox"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Content="Только с вложениями"/>
                        <TextBlock VerticalAlignment="Center" Text="С:"/>
                        <DatePicker x:Name="SearchFromDatePicker" Width="120" Margin="6,0,12,0"/>
                        <TextBlock VerticalAlignment="Center" Text="По:"/>
                        <DatePicker x:Name="SearchToDatePicker" Width="120" Margin="6,0,12,0"/>
                        <Button Padding="16,7"
                                Click="SearchButton_Click"
                                Content="Найти"/>
                    </WrapPanel>

                    <DataGrid x:Name="SearchResultsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Отправитель" Width="200" Binding="{Binding SenderDisplay}"/>
                            <DataGridTextColumn Header="Тема" Width="*" Binding="{Binding Subject}"/>
                            <DataGridTextColumn Header="Дата" Width="140" Binding="{Binding DateDisplay}"/>
                            <DataGridTextColumn Header="Размер" Width="90" Binding="{Binding SizeDisplay}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="SearchStatusText"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                        <Button DockPanel.Dock="Right"
                                Padding="14,7"
                                Click="OpenSearchResultButton_Click"
                                Content="Открыть выбранное письмо"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="ContactsTab" Header="Контакты">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Padding="16,7"
                                Click="LoadContactsButton_Click"
                                Content="Загрузить контакты"/>
                        <TextBlock x:Name="ContactsStatusText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </StackPanel>

                    <ListBox x:Name="ContactsListBox"
                             Grid.Row="1"
                             MouseDoubleClick="ContactsListBox_MouseDoubleClick"/>

                    <Button Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="14,7"
                            HorizontalAlignment="Left"
                            Click="ComposeToContactButton_Click"
                            Content="Написать выбранному"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="ComposeTab" Header="Написать">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Кому"/>
                    <TextBox x:Name="ComposeToTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Тема"/>
                    <TextBox x:Name="ComposeSubjectTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button x:Name="AttachButton"
                                Padding="14,7"
                                Click="AttachButton_Click"
                                Content="Добавить вложения"/>
                        <TextBlock x:Name="AttachmentSummaryText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Вложений нет"/>
                    </StackPanel>

                    <TextBox x:Name="ComposeBodyTextBox"
                             Grid.Row="3" Grid.ColumnSpan="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"/>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SendButton"
                                Grid.Column="0"
                                Padding="22,9"
                                Click="SendButton_Click"
                                Content="Отправить"/>

                        <TextBlock x:Name="ComposeStatusText"
                                   Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>