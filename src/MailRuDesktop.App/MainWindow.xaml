<Window x:Class="MailRuDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailRu Desktop" Height="640" Width="980"
        MinHeight="520" MinWidth="760">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MailRu Desktop · protocol bootstrap"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="LoginTextBox"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     Padding="8"
                     ToolTip="Mail.ru login"/>

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         Padding="8"
                         ToolTip="Password is kept in memory only"/>

            <Button x:Name="AuthenticateButton"
                    Grid.Column="2"
                    Padding="18,8"
                    Click="AuthenticateButton_Click"
                    Content="Войти"/>

            <TextBlock x:Name="AuthStatusText"
                       Grid.Column="3"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Text="Не авторизовано"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderIdTextBox"
                     Grid.Column="0"
                     Padding="8"
                     Text="0"
                     ToolTip="Mail.ru folder numeric id"/>

            <Button x:Name="LoadFolderButton"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="18,8"
                    Click="LoadFolderButton_Click"
                    Content="Загрузить папку"/>

            <TextBlock Grid.Column="2"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Text="Первый срез: авторизация + сырой threads/status/smart"/>
        </Grid>

        <TextBox x:Name="ResponseTextBox"
                 Grid.Row="3"
                 FontFamily="Consolas"
                 FontSize="13"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"/>
    </Grid>
</Window>
