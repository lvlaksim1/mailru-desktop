<Window x:Class="MailRuDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MailRuDesktop.App"
        Title="MailRu Desktop"
        Icon="{StaticResource AppIcon}"
        Height="900" Width="1500"
        MinHeight="720" MinWidth="1120"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:MailDateConverter x:Key="MailDateConverter"/>
        <local:MailTimeConverter x:Key="MailTimeConverter"/>
        <local:SenderLineConverter x:Key="SenderLineConverter"/>
        <local:FirstLineConverter x:Key="FirstLineConverter"/>

        <DataTemplate DataType="{x:Type local:AccountRailItem}">
            <Grid ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="{DynamicResource AppAvatarSize}" Height="{DynamicResource AppAvatarSize}"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppControlHoverBrush}">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource AppFontTinySize}"
                                   FontWeight="SemiBold"
                                   Text="{Binding IconText}"/>
                        <Image Width="{DynamicResource AppAvatarSize}" Height="{DynamicResource AppAvatarSize}" Stretch="UniformToFill"
                               Source="{Binding AvatarUrl}"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Login}"/>
                <Border Grid.Column="2"
                        MinWidth="24" Height="20"
                        Margin="6,0,0,0"
                        Padding="5,0"
                        CornerRadius="10"
                        Background="{DynamicResource AppAccentBrush}"
                        ToolTip="Непрочитанные письма во Входящих"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource AppFontTinySize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccentTextBrush}"
                               Text="{Binding UnreadDisplay}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AccountSectionItem}">
            <Button Padding="6,5"
                    HorizontalContentAlignment="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="AccountSectionButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}"/>
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="{Binding Arrow}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- All visual states are explicit. The default Windows Button chrome
             previously produced a pale cyan hover outside the 26-role palette. -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavButtonSurface" Property="Background"
                                        Value="{DynamicResource AppControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavButtonSurface" Property="Background"
                                        Value="{DynamicResource AppControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavButtonSurface" Property="BorderBrush"
                                        Value="{DynamicResource AppFocusBrush}"/>
                                <Setter TargetName="NavButtonSurface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundAccountItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Padding="8,4" CornerRadius="6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Padding="6,5"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactContextMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="154"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemRoot"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemRoot"
                                        Property="Background"
                                        Value="{DynamicResource AppControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource CompactContextMenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationPaneColumn" Width="230"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="AccountPaneColumn" Width="220" MinWidth="140" MaxWidth="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <local:SelectableText Text="MailRu Desktop" Margin="4,2,4,12" FontSize="{DynamicResource AppFontHeadingSize}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Mail remains the default workspace; choose contacts in compose. -->

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:SelectableText Grid.Row="0"
                               Margin="4,2,4,8"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="ПАПКИ"/>

                    <ListBox x:Name="FolderListBox"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="FolderListBox_SelectionChanged"
                              PreviewMouseLeftButtonUp="FolderListBox_PreviewMouseLeftButtonUp"
                              PreviewKeyDown="FolderListBox_PreviewKeyDown"/>

                    <Expander x:Name="FolderManageExpander"
                              Grid.Row="2"
                              Margin="0,8,0,0"
                              Header="Управление папками"
                              IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <TextBox x:Name="FolderNameTextBox"
                                     Padding="7"
                                     Margin="0,0,0,6"
                                     ToolTip="Имя новой папки или новое имя выбранной"/>
                            <WrapPanel>
                                <Button Padding="8,5" Margin="0,0,4,4" Click="CreateFolderButton_Click" Content="Создать"/>
                                <Button Padding="8,5" Margin="0,0,4,4" Click="RenameFolderButton_Click" Content="Переименовать"/>
                                <Button Padding="8,5" Margin="0,0,4,4" Click="DeleteFolderButton_Click" Foreground="{DynamicResource AppDangerBrush}" Content="Удалить"/>
                                <Button Padding="8,5" Margin="0,0,4,4" Click="ClearFolderButton_Click" Content="Очистить"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Grid>

                <StackPanel Grid.Row="3">
                    <Button x:Name="OpenExcelMailingButton"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,0,5" Content="Рассылки Excel"
                            Click="OpenExcelMailingButton_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="ShowSettingsButton_Click" Content="⚙  Настройки"/>
                </StackPanel>
                <local:SelectableText x:Name="AuthStatusText"
                           Grid.Row="4"
                           Margin="8,8,8,2"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource AppFontSmallSize}"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="Не авторизовано"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Grid Grid.Column="2" Margin="14">
            <Grid x:Name="MailWorkspace" Loaded="PreviewEnhancements_Loaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MailListPaneColumn" Width="455"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterQueryTextBox"
                                 Grid.Column="0"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="{DynamicResource AppFontFormSize}"
                                 TextChanged="UnifiedSearchTextBox_TextChanged"
                                 ToolTip="Ищет по адресу и имени отправителя, теме и текстовому фрагменту письма"/>
                        <Button x:Name="ServerSearchButton"
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="13,7"
                                Click="ServerSearchButton_Click"
                                Content="Найти на сервере"/>
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                Padding="10,7"
                                Click="ResetFilterButton_Click"
                                Content="Сбросить"/>
                        <Button x:Name="RefreshFolderButton"
                                Grid.Column="3"
                                Width="38"
                                Margin="6,0,0,0"
                                Padding="0"
                                Click="RefreshFolderButton_Click"
                                ToolTip="Обновить"
                                Content="↻"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                            <!-- New Mail belongs at the upper right of the message list,
                                 independent of selection actions that may wrap. -->
                            <Button x:Name="MainComposeButton" DockPanel.Dock="Right"
                                    Padding="12,5" Margin="10,0,0,4"
                                    FontWeight="SemiBold" Click="ShowComposeButton_Click"
                                    Content="✎  Новое письмо"/>
                            <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="BulkTrashButton" Padding="10,5" Margin="0,0,5,4"
                                    Click="BulkTrashButton_Click" Content="В корзину"/>
                            <Button x:Name="BulkArchiveButton" Padding="10,5" Margin="0,0,5,4"
                                    Click="BulkArchiveButton_Click" Content="В архив"/>
                            <Button x:Name="BulkReadButton" Padding="10,5" Margin="0,0,5,4"
                                    Click="BulkReadButton_Click" Content="Прочитано"/>
                            <Button x:Name="BulkDeletePermanentlyButton" Padding="10,5" Margin="0,0,5,4"
                                    Visibility="Collapsed" Foreground="{DynamicResource AppDangerBrush}"
                                    Click="BulkDeletePermanentlyButton_Click" Content="Удалить из корзины"/>
                            <Button x:Name="BulkSendNowButton" Padding="10,5" Margin="0,0,5,4"
                                    Visibility="Collapsed" Click="BulkSendNowButton_Click"
                                    ToolTip="Подготовить копию, удалить исходное расписание и отправить немедленно"
                                    Content="Отправить сейчас"/>
                            <local:SelectableText x:Name="BulkSelectedCountText" Margin="6,0,0,4"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       Text="Выбрано: 0"/>
                            </WrapPanel>
                        </DockPanel>
                        <Grid Visibility="Collapsed">
                            <TextBox x:Name="FilterSenderTextBox"/>
                            <TextBox x:Name="FilterSubjectTextBox"/>
                            <CheckBox x:Name="FilterAttachmentsCheckBox"/>
                            <DatePicker x:Name="FilterFromDatePicker"/>
                            <DatePicker x:Name="FilterToDatePicker"/>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="MessagesGrid"
                             Grid.Row="2" SelectionMode="Multiple"
                             PreviewKeyDown="MessagesGrid_PreviewKeyDown"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource MailCardItemStyle}"
                             SelectionChanged="MessagesGrid_SelectionChanged">
                        <!-- The only message-row template is installed by ConfigureModernMailList.
                             Do not define a second fallback row here: stale actions and
                             columns previously diverged from the displayed list. -->

                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="4,8,4,0">
                        <local:SelectableText x:Name="FolderStatusText" Foreground="{DynamicResource AppMutedTextBrush}" Text="Выберите аккаунт"/>
                        <local:SelectableText x:Name="FilterStatusText" Margin="0,2,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </StackPanel>
                </Grid>

<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource AppPanelBrush}"
                        CornerRadius="10"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="PreviewForwardButton" Padding="10,6" Margin="0,0,6,4" Click="PreviewForwardButton_Click" Content="Переслать"/>
                            <Button x:Name="PreviewSendNowButton" Visibility="Collapsed"
                                    Margin="0,0,6,4" Padding="10,6"
                                    Click="PreviewSendNowButton_Click"
                                    ToolTip="Создать копию, отменить исходную отправку и отправить копию"
                                    Content="Отправить сейчас"/>
                            <Button x:Name="MoveMessageButton" Padding="10,6" Margin="0,0,6,4" Click="MoveMessageButton_Click" Content="Переместить в"/>
                            <ComboBox x:Name="MoveFolderComboBox"
                                      Width="165"
                                      Margin="0,0,6,4"
                                      DisplayMemberPath="Name"
                                      TextSearch.TextPath="Name"
                                      ToolTip="Папка назначения"/>
                        </WrapPanel>

                        <local:MailReaderHeader x:Name="ReaderHeader" Grid.Row="2"/>

                        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                            <Button x:Name="PreviewReplyButton" Padding="10,6" Margin="0,0,6,4" Click="PreviewReplyButton_Click" Content="Ответить"/>
                            <Button x:Name="PreviewArchiveButton" Padding="10,6" Margin="0,0,6,4" Click="PreviewArchiveButton_Click" Content="В архив"/>
                            <Button x:Name="TrashMessageButton" Padding="10,6" Margin="0,0,6,4" Click="TrashMessageButton_Click" Content="В корзину"/>
                        </WrapPanel>

                        <Border Grid.Row="4" Height="1" Margin="0,0,0,10" Background="{DynamicResource AppBorderBrush}"/>

                        <Border Grid.Row="6"
                                Background="{DynamicResource AppWindowBrush}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1">
                            <!-- No WPF overlay over WebView2: the permanent
                                 browser shell owns its loading layer. -->
                            <wv2:WebView2 x:Name="MessageWebView"/>
                        </Border>

                        <StackPanel x:Name="IncomingAttachmentsPanel"
                                    Grid.Row="5"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                            <local:SelectableText FontWeight="SemiBold" Text="Вложения"/>
                            <ListBox x:Name="IncomingAttachmentsListBox"
                                     PreviewMouseLeftButtonDown="IncomingAttachmentsListBox_PreviewMouseLeftButtonDown"
                                     MaxHeight="110"
                                     Margin="0,5,0,0"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}"/>
                                            <TextBlock FontSize="{DynamicResource AppFontSmallSize}" Foreground="{DynamicResource AppMutedTextBrush}" Text="{Binding DisplayMeta}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,7,0,0">
                                <Button x:Name="DownloadAttachmentButton"
                                        Visibility="Collapsed"
                                        Margin="0,0,6,0"
                                        Padding="11,6"
                                        Click="DownloadAttachmentButton_Click"
                                        Content="Скачать вложение"/>
                                <Button x:Name="DownloadAllAttachmentsButton"
                                        Visibility="Collapsed"
                                        Padding="11,6"
                                        Click="DownloadAllAttachmentsButton_Click"
                                        Content="Скачать всё"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border x:Name="PreviewComposePanel"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="12"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                Background="{DynamicResource AppWindowBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="130"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0">
                                    <local:SelectableText Margin="0,0,6,0" VerticalAlignment="Center" Text="Из шаблона:"/>
                                    <ComboBox x:Name="PreviewTemplateComboBox"
                                              Width="210"
                                              DisplayMemberPath="Name"
                                              DropDownOpened="PreviewTemplateComboBox_DropDownOpened"
                                              PreviewMouseLeftButtonUp="PreviewTemplateComboBox_PreviewMouseLeftButtonUp"
                                              PreviewKeyDown="PreviewTemplateComboBox_PreviewKeyDown"
                                              SelectionChanged="PreviewTemplateComboBox_SelectionChanged"/>
                                    <local:SelectableText Margin="0,0,6,0" VerticalAlignment="Center" Text="Подпись:"/>
                                    <ComboBox x:Name="PreviewSignatureComboBox"
                                              Width="180"
                                              Margin="0,0,14,0"
                                              DisplayMemberPath="Name"
                                              DropDownOpened="PreviewSignatureComboBox_DropDownOpened"
                                              PreviewMouseLeftButtonUp="PreviewSignatureComboBox_PreviewMouseLeftButtonUp"
                                              PreviewKeyDown="PreviewSignatureComboBox_PreviewKeyDown"
                                              SelectionChanged="PreviewSignatureComboBox_SelectionChanged"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Width="26" Height="26" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            ToolTip="Закрыть форму ответа"
                                            Click="PreviewCancelComposeButton_Click" Content="×"/>
                                </Grid>

                                <local:SelectableText Grid.Row="1" Margin="0,0,8,7" VerticalAlignment="Center" Text="Кому:"/>
                                <TextBox x:Name="PreviewComposeToTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,7" Padding="7"/>
                                <local:SelectableText Grid.Row="2" Margin="0,0,8,7" VerticalAlignment="Center" Text="Тема:"/>
                                <TextBox x:Name="PreviewComposeSubjectTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,7" Padding="7"/>
                                <local:SelectableText Grid.Row="3" Margin="0,0,8,7" VerticalAlignment="Top" Text="Вложения:"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,7">
                                    <Button Width="130" HorizontalAlignment="Left" Padding="10,5" Click="PreviewComposeAttachButton_Click" Content="Добавить файл"/>
                                    <ItemsControl x:Name="PreviewComposeAttachmentsItemsControl" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Padding="6,2" Margin="8,0,0,0" Tag="{Binding Path}" Click="PreviewRemoveAttachmentButton_Click" Content="Удалить"/>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <local:SelectableText Grid.Row="4" Margin="0,0,8,0" VerticalAlignment="Top" Text="Текст:"/>
                                <TextBox x:Name="PreviewComposeBodyTextBox"
                                         Grid.Row="4" Grid.Column="1"
                                         Padding="7"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,9,0,0">
                                    <CheckBox x:Name="PreviewReadReceiptCheckBox"
                                              Margin="0,0,0,7"
                                              Content="Запрос подтверждения прочтения письма"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="PreviewScheduleCheckBox" Margin="0,0,10,0"
                                                  VerticalAlignment="Center" Content="Отложенная отправка"/>
                                        <DatePicker x:Name="PreviewScheduleDatePicker" Width="130" Margin="0,0,6,0"
                                                    IsEnabled="{Binding IsChecked, ElementName=PreviewScheduleCheckBox}"/>
                                        <TextBox x:Name="PreviewScheduleTimeTextBox" Width="75" Padding="5" Text="09:00"
                                                 IsEnabled="{Binding IsChecked, ElementName=PreviewScheduleCheckBox}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,9,0,0">
                                    <Button x:Name="PreviewSendComposeButton" Padding="14,7" Margin="0,0,6,0" Click="PreviewSendComposeButton_Click" Content="Отправить"/>
                                    <Button Padding="14,7" Margin="0,0,12,0" Click="PreviewCancelComposeButton_Click" Content="Отмена"/>
                                    <local:SelectableText x:Name="PreviewComposeStatusText" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ContactsWorkspace" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ContactsListPaneColumn" Width="390"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:SelectableText FontSize="{DynamicResource AppFontHeroSize}" FontWeight="SemiBold" Text="Контакты"/>
                        <Grid Grid.Row="1" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ContactSearchTextBox" Padding="8" ToolTip="Поиск по контактам"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,6" Click="SearchContactsButton_Click" Content="Найти"/>
                        </Grid>
                        <ListBox x:Name="ContactsListBox" Grid.Row="2" BorderThickness="0" MouseDoubleClick="ContactsListBox_MouseDoubleClick"/>
                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <Button Padding="12,7" Click="LoadContactsButton_Click" Content="Обновить адресную книгу"/>
                            <local:SelectableText x:Name="ContactsStatusText" Margin="0,7,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                <Border Grid.Column="2" Margin="8,0,0,0" Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="22">
                    <StackPanel>
                        <local:SelectableText FontSize="{DynamicResource AppFontHeroSize}" FontWeight="SemiBold" Text="Адресная книга"/>
                        <local:SelectableText Margin="0,10,0,18" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Text="Выберите контакт слева. Двойной щелчок откроет создание письма этому адресату."/>
                        <Button Width="170" HorizontalAlignment="Left" Padding="14,8" Click="ComposeToContactButton_Click" Content="Написать письмо"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ComposeWorkspace" Visibility="Collapsed">
                <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="22" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:SelectableText x:Name="ComposeHeaderText" FontSize="{DynamicResource AppFontHeroSize}" FontWeight="SemiBold" Text="Новое письмо"/>
                        <Grid x:Name="ComposeSenderRow" Grid.Row="1" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <local:SelectableText VerticalAlignment="Center" Text="От"/>
                            <TextBox x:Name="ComposeFromTextBox" Grid.Column="1" Padding="8"
                                     IsReadOnly="True"
                                     ToolTip="Аккаунт отправителя закрепляется при создании письма"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,16,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <local:SelectableText VerticalAlignment="Center" Text="Кому"/>
                            <TextBox x:Name="ComposeToTextBox" Grid.Column="1" Padding="8"/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6"
                                    Click="ChooseComposeContactButton_Click" Content="Из контактов…"/>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <local:SelectableText VerticalAlignment="Center" Text="Тема"/>
                            <TextBox x:Name="ComposeSubjectTextBox" Grid.Column="1" Padding="8"/>
                        </Grid>
                        <StackPanel Grid.Row="4" Margin="70,0,0,8">
                            <WrapPanel Margin="0,0,0,8">
                                <local:SelectableText Text="Шаблон:" VerticalAlignment="Center"
                                           Margin="2,0,6,0"/>
                                <ComboBox x:Name="ComposeTemplateComboBox" Width="235"
                                          DisplayMemberPath="Name" SelectionChanged="ComposeTemplateComboBox_SelectionChanged"
                                          DropDownOpened="ComposeTemplateComboBox_DropDownOpened"
                                          PreviewMouseLeftButtonUp="ComposeTemplateComboBox_PreviewMouseLeftButtonUp"
                                          PreviewKeyDown="ComposeTemplateComboBox_PreviewKeyDown"
                                          ToolTip="Заполнить из шаблона"/>
                                <local:SelectableText Text="Подпись:" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="ComposeSignatureComboBox" Width="205" Margin="0,0,8,0"
                                          DisplayMemberPath="Name" SelectionChanged="ComposeSignatureComboBox_SelectionChanged"
                                          DropDownOpened="ComposeSignatureComboBox_DropDownOpened"
                                          PreviewMouseLeftButtonUp="ComposeSignatureComboBox_PreviewMouseLeftButtonUp"
                                          PreviewKeyDown="ComposeSignatureComboBox_PreviewKeyDown"
                                          ToolTip="Добавить подпись" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AttachButton" Padding="12,6" Click="AttachButton_Click" Content="Вложить файл"/>
                                <local:SelectableText x:Name="AttachmentSummaryText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" Text="Вложений нет"/>
                            </StackPanel>
                            <ItemsControl x:Name="ComposeAttachmentsItemsControl" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Padding="6,2" Margin="8,0,0,0" Tag="{Binding Path}" Click="RemoveComposeAttachmentButton_Click" Content="Удалить"/>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBox x:Name="ComposeBodyTextBox" Grid.Row="5" Margin="70,0,0,10" MinHeight="320" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="6" Margin="70,0,0,10">
                            <CheckBox x:Name="ArchiveAfterReplyCheckBox"
                                      IsChecked="True" Visibility="Collapsed" Margin="0,0,0,8"
                                      Content="После отправки отправить в архив"/>
                            <CheckBox x:Name="RequestReadReceiptCheckBox"
                                      Margin="0,0,0,8"
                                      Content="Запрос подтверждения прочтения письма"/>
                            <WrapPanel>
                                <CheckBox x:Name="ScheduleSendCheckBox"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Content="Отложенная отправка"/>
                                <DatePicker x:Name="ScheduleDatePicker"
                                            Width="130" Margin="0,0,6,0"
                                            IsEnabled="{Binding IsChecked, ElementName=ScheduleSendCheckBox}"/>
                                <TextBox x:Name="ScheduleTimeTextBox"
                                         Width="75" Padding="5" Text="09:00"
                                         IsEnabled="{Binding IsChecked, ElementName=ScheduleSendCheckBox}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Row="7" Margin="70,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="SendButton" Padding="20,9" Margin="0,0,6,0" Click="SendButton_Click" Content="Отправить"/>
                            <Button x:Name="SaveDraftButton" Grid.Column="1" Padding="16,9" Click="SaveDraftButton_Click" Content="Сохранить черновик"/>
                            <local:SelectableText x:Name="ComposeStatusText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SettingsWorkspace" Visibility="Collapsed" Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsOptionsColumn" Width="620" MinWidth="390"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <local:SelectableText FontSize="{DynamicResource AppFontHeroSize}" FontWeight="SemiBold" Text="Настройки"/>
                        <GroupBox Margin="0,16,0,0" Header="Уведомления о новых письмах">
                            <StackPanel Margin="12">
                                <!-- Retained only for backward-compatible background-setting code.
                                     Manual group management owns MCS; don't show an inert toggle. -->
                                <CheckBox x:Name="BackgroundPushEnabledCheckBox" Visibility="Collapsed"
                                          Checked="BackgroundPushEnabledCheckBox_Changed"
                                          Unchecked="BackgroundPushEnabledCheckBox_Changed"/>
                                <CheckBox x:Name="TaskbarNotificationsEnabledCheckBox"
                                          Content="Показывать уведомления Windows о новых письмах"
                                          Checked="TaskbarNotificationsEnabledCheckBox_Changed"
                                          Unchecked="TaskbarNotificationsEnabledCheckBox_Changed"/>
                                <CheckBox x:Name="ReplaySuppressionEnabledCheckBox"
                                          Margin="0,9,0,0"
                                          Content="Не показывать повторно ранее полученные уведомления"
                                          Checked="ReplaySuppressionEnabledCheckBox_Changed"
                                          Unchecked="ReplaySuppressionEnabledCheckBox_Changed"/>
                                <local:SelectableText Margin="20,3,0,0"
                                           Text="Локальная защита от повторов. Отключение не меняет подтверждения Google."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                <local:SelectableText x:Name="BackgroundPushStatusText" Margin="0,9,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="Состояние приёма уведомлений…"/>
                                <Button x:Name="OpenPushGroupManagerButton" Content="Google и группы PushMe"
                                        Margin="0,12,0,0" Padding="12,7"
                                        HorizontalAlignment="Left"
                                        Click="OpenPushGroupManagerButton_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Margin="0,16,0,0" Header="Внешний вид">
                            <StackPanel Margin="12">
                                <local:SelectableText Margin="0,0,0,6" Text="Тема"/>
                                <ComboBox x:Name="ThemeComboBox" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                                    <ComboBoxItem Content="Системная" Tag="System"/>
                                </ComboBox>
                                <local:SelectableText Margin="0,8,0,0" Foreground="{DynamicResource AppMutedTextBrush}" Text="При первом запуске используется тёмная тема."/>
                                <Separator Margin="0,12,0,10"/>
                                <local:SelectableText FontWeight="SemiBold" Text="Размер текста интерфейса"/>
                                <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="InterfaceFontSlider"
                                            Minimum="10" Maximum="18" Value="12"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Width="230" VerticalAlignment="Center"
                                            ValueChanged="InterfaceFontSlider_ValueChanged"
                                            ToolTip="Основной размер шрифта, в логических пикселях"/>
                                    <local:SelectableText x:Name="InterfaceFontValueText"
                                               Margin="12,0,0,0" Width="100"
                                               VerticalAlignment="Center" Text="12 пикс."/>
                                    <Button Content="По умолчанию" Padding="9,5"
                                            Click="ResetInterfaceFontButton_Click"/>
                                </WrapPanel>
                                <local:SelectableText Margin="0,7,0,0" Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Размер заголовков, подписей и обычного текста изменяется согласованно. Форматирование полученных писем не меняется."/>
                                <Separator Margin="0,12,0,10"/>
                                <CheckBox x:Name="SpellCheckEnabledCheckBox"
                                          Content="Проверять орфографию при написании писем"
                                          Checked="SpellCheckEnabledCheckBox_Changed"
                                          Unchecked="SpellCheckEnabledCheckBox_Changed"/>
                                <local:SelectableText Margin="20,4,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Проверка выполняется средствами Windows без передачи текста в интернет. Для русского и английского нужны соответствующие языковые словари Windows."/>
                        <Expander Margin="0,16,0,0" IsExpanded="False" Header="Цветовая схема"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  Background="{DynamicResource AppPanelBrush}">
                            <StackPanel Margin="12">
                                <local:SelectableText TextWrapping="Wrap" Margin="0,0,0,11"
                                           Text="Один основной цвет задаёт восемь согласованных оттенков для всего интерфейса. Светлая, тёмная и системная темы используют один и тот же выбранный цвет."/>
                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Border x:Name="PrimaryColorSwatch" Width="32" Height="32"
                                            CornerRadius="5" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"/>
                                    <local:SelectableText Text="Основной цвет" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBox x:Name="PrimaryColorTextBox" Width="95"
                                             VerticalAlignment="Center" MaxLength="7"
                                             Padding="6" Margin="0,0,8,0"
                                             ToolTip="Введите #RRGGBB"
                                             TextChanged="PrimaryColorTextBox_TextChanged"/>
                                    <Button Padding="10,6" Margin="0,0,8,0"
                                            Click="PickPrimaryColorButton_Click"
                                            Content="Выбрать"/>
                                    <Button Padding="10,6" Click="ResetPrimaryColorButton_Click"
                                            Content="По умолчанию"/>
                                </WrapPanel>
                                <local:SelectableText x:Name="PrimaryColorStatusText"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap"/>
                                <local:SelectableText Margin="0,8,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Зелёный, красный и жёлтый цвета состояний, а также звезда и булавка, сохраняют своё значение независимо от темы."/>
                            </StackPanel>
                        </Expander>

                            </StackPanel>
                        </GroupBox>
                        <Expander x:Name="SignaturesSettingsExpander" Margin="0,16,0,0" Header="Подписи" IsExpanded="False">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="SignaturesListBox"
                                         Grid.RowSpan="2"
                                         MinHeight="150"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="SignaturesListBox_SelectionChanged"/>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="SignatureNameTextBox" Padding="7" ToolTip="Название подписи"/>
                                    <TextBox x:Name="SignatureBodyTextBox"
                                             Grid.Row="1"
                                             Margin="0,7,0,7"
                                             MinHeight="105"
                                             Padding="7"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <WrapPanel Grid.Row="2">
                                        <Button Padding="10,6" Margin="0,0,6,0" Click="NewSignatureButton_Click" Content="Новая"/>
                                        <Button Padding="10,6" Margin="0,0,6,0" Click="SaveSignatureButton_Click" Content="Сохранить"/>
                                        <Button Padding="10,6" Click="DeleteSignatureButton_Click" Foreground="{DynamicResource AppDangerBrush}" Content="Удалить"/>
                                        <Button x:Name="DefaultSignatureButton"
                                                Margin="6,0,0,0" Padding="10,6"
                                                Click="DefaultSignatureButton_Click"
                                                Content="Сделать основной"
                                                ToolTip="Автоматически добавлять подпись в новые письма и ответы"/>
                                        <Button Padding="10,6" Margin="6,0,0,0"
                                                Click="OpenSignaturesFolderButton_Click"
                                                Content="Открыть папку подписей"/>
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Expander>

                        <Expander x:Name="TemplatesSettingsExpander" Margin="0,16,0,0"
                                  Header="Шаблоны" IsExpanded="False">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <local:SelectableText Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Выберите шаблон или создайте новый. Редактирование открывается в отдельном окне."/>
                                <ListBox x:Name="MailTemplatesListBox" Grid.Row="1"
                                         MinHeight="130" MaxHeight="280"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="MailTemplatesListBox_SelectionChanged"
                                         MouseDoubleClick="MailTemplatesListBox_MouseDoubleClick"/>
                                <WrapPanel Grid.Row="2" Margin="0,9,0,0">
                                    <Button Padding="10,6" Margin="0,0,6,6"
                                            Click="NewMailTemplateButton_Click" Content="Создать"/>
                                    <Button x:Name="EditSelectedTemplateButton" Padding="10,6"
                                            Margin="0,0,6,6" IsEnabled="False"
                                            Click="EditMailTemplateButton_Click" Content="Редактировать"/>
                                    <Button x:Name="DeleteSelectedTemplateButton" Padding="10,6"
                                            Margin="0,0,6,6" IsEnabled="False"
                                            Click="DeleteMailTemplateButton_Click"
                                            Foreground="{DynamicResource AppDangerBrush}" Content="Удалить"/>
                                    <Button Padding="10,6" Margin="0,0,6,6"
                                            Click="ImportMailTemplateButton_Click" Content="Загрузить .md"/>
                                    <Button Padding="10,6" Margin="0,0,6,6"
                                            Click="OpenTemplatesFolderButton_Click" Content="Открыть папку"/>
                                </WrapPanel>
                            </Grid>
                        </Expander>

                        <GroupBox Margin="0,16,0,0" Header="Папка скачивания вложений">
                            <StackPanel Margin="12">
                                <local:SelectableText Margin="0,0,0,5" Text="Загруженные файлы и архивы вложений"/>
                                <DockPanel Margin="0,5,0,0" LastChildFill="True">
                                    <Button DockPanel.Dock="Left" Content="Обзор…" Margin="0,0,9,0"
                                            Padding="12,6" Click="BrowseDownloadDirectoryButton_Click"/>
                                    <local:SelectableText x:Name="AttachmentDownloadDirectoryText"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>
                                <local:SelectableText x:Name="AttachmentDirectoryStatusText" Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>

<GroupBox Margin="0,16,0,0" Header="Папка шаблонов">
                            <StackPanel Margin="12">
                                <local:SelectableText Margin="0,0,0,5" Text="Расположение файлов .md и вложений"/>
                                <DockPanel Margin="0,5,0,0" LastChildFill="True">
                                    <Button DockPanel.Dock="Left" Padding="12,6" Margin="0,0,9,0"
                                            Content="Обзор…" Click="BrowseTemplateDirectoryButton_Click"/>
                                    <local:SelectableText x:Name="TemplateDirectoryText" VerticalAlignment="Center"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </DockPanel>
                                <local:SelectableText x:Name="TemplateDirectoryStatusText" Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Margin="0,16,0,0" Header="Обновление">
                            <StackPanel Margin="12">
                                <WrapPanel>
                                    <Button x:Name="CheckForUpdatesButton"
                                            Padding="14,7"
                                            Click="CheckForUpdatesButton_Click"
                                            Content="Проверить обновления"/>
                                    <Button x:Name="InstallUpdateButton"
                                            Visibility="Collapsed"
                                            Margin="8,0,0,0"
                                            Padding="14,7"
                                            Click="InstallUpdateButton_Click"
                                            Content="Обновить"/>
                                    <Button Margin="8,0,0,0"
                                            Padding="14,7"
                                            Click="OpenReleasesButton_Click"
                                            Content="Открыть страницу выпусков"/>
                                </WrapPanel>
                                <local:SelectableText x:Name="UpdateStatusText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="Обновления проверяются напрямую в выпусках GitHub."/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource AppBorderBrush}"
                              ToolTip="Изменить ширину настроек и диагностики"/>

                <!-- All diagnostics share one collapsed instrument in the right-hand
                     settings column. The ordinary notifications area stays clean. -->
                <ScrollViewer Grid.Column="2" Margin="14,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Expander x:Name="UnifiedDiagnosticsExpander"
                              Margin="0,16,0,0"
                              Header="Диагностика"
                              IsExpanded="False"
                              Foreground="{DynamicResource AppTextBrush}">
                        <StackPanel Margin="10,8,10,10">
                            <local:SelectableText Text="Технические журналы и проверка подключения"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TabControl x:Name="UnifiedDiagnosticsTabs"
                                        Margin="0,12,0,0"
                                        SelectionChanged="UnifiedDiagnosticsTabs_SelectionChanged">
                                <TabItem Header="Google / PushMe">
                                    <StackPanel Margin="7,10,7,6">
                                        <local:SelectableText x:Name="GoogleRecipientStatusText"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <local:SelectableText x:Name="GoogleMcsStatusText"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <Button x:Name="OpenPushProbeButton"
                                                Content="Проверить один аккаунт"
                                                Margin="0,11,0,0" Padding="10,6"
                                                HorizontalAlignment="Left"
                                                Click="OpenPushProbeButton_Click"/>
                                        <TextBox x:Name="PushDiagnosticsLogTextBox"
                                                 Margin="0,11,0,0" Height="590"
                                                 FontFamily="Consolas" FontSize="12"
                                                 IsReadOnly="True" IsUndoEnabled="False"
                                                 TextWrapping="NoWrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                        <local:SelectableText Margin="0,9,0,4"
                                                   Text="Сведения об аккаунтах в отчёте:"/>
                                        <ComboBox x:Name="PushDiagnosticsExportModeComboBox"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Без адресов"/>
                                            <ComboBoxItem Content="С адресами"/>
                                        </ComboBox>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="RefreshPushDiagnosticsButton"
                                                    Content="Обновить" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="RefreshPushDiagnosticsButton_Click"/>
                                            <Button x:Name="CopyPushDiagnosticsButton"
                                                    Content="Копировать" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="CopyPushDiagnosticsButton_Click"/>
                                            <Button x:Name="SavePushDiagnosticsButton"
                                                    Content="Сохранить" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="SavePushDiagnosticsButton_Click"/>
                                            <Button x:Name="ClearPushDiagnosticsButton"
                                                    Content="Очистить" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="ClearPushDiagnosticsButton_Click"/>
                                        </WrapPanel>
                                        <local:SelectableText x:Name="PushDiagnosticsActionStatusText"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Протокол">
                                    <StackPanel Margin="7,10,7,6">
                                        <local:SelectableText Text="Последний ответ почтового сервера и сведения о запросах."
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <TextBox x:Name="ResponseTextBox" Height="590"
                                                 Margin="0,10,0,0"
                                                 FontFamily="Consolas" FontSize="11"
                                                 AcceptsReturn="True" AcceptsTab="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 IsReadOnly="True" TextWrapping="NoWrap"/>
                                        <Button Content="Копировать" Margin="0,10,0,0"
                                                Padding="10,6" HorizontalAlignment="Left"
                                                Click="CopyDiagnosticsButton_Click"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Приложение">
                                    <StackPanel Margin="7,10,7,6">
                                        <local:SelectableText Text="Журнал работы приложения. При копировании личные данные скрываются."
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBox x:Name="ApplicationDiagnosticsLogTextBox"
                                                 Margin="0,10,0,0" Height="590"
                                                 FontFamily="Consolas" FontSize="11"
                                                 IsReadOnly="True" IsUndoEnabled="False"
                                                 TextWrapping="NoWrap"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Обновить" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="RefreshApplicationDiagnosticsButton_Click"/>
                                            <Button Content="Копировать" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="CopyApplicationDiagnosticsButton_Click"/>
                                            <Button Content="Сохранить" Padding="9,6"
                                                    Margin="0,0,6,6"
                                                    Click="SaveApplicationDiagnosticsButton_Click"/>
                                        </WrapPanel>
                                        <local:SelectableText x:Name="ApplicationDiagnosticsStatusText"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Expander>
                </ScrollViewer>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Column="4"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="6,2,2,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:SelectableText VerticalAlignment="Center"
                               FontSize="{DynamicResource AppFontSmallSize}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="АККАУНТЫ"/>
                    <Button Grid.Column="1"
                            Padding="7,3"
                            BorderThickness="0"
                            Background="Transparent"
                            Click="AddAccountSectionButton_Click"
                            ToolTip="Добавить раздел аккаунтов"
                            Content="+ Раздел"/>
                </Grid>
                <ListBox x:Name="AccountRailListBox"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource RoundAccountItemStyle}"
                         SelectionChanged="AccountRailListBox_SelectionChanged"
                         PreviewMouseRightButtonDown="AccountRailListBox_PreviewMouseRightButtonDown"/>
                <Button x:Name="AddAccountButton" Grid.Row="2" Margin="2,8,2,2" Padding="8,6" HorizontalAlignment="Stretch" Click="AddAccountButton_Click" ToolTip="Добавить аккаунт" Content="+ Добавить аккаунт"/>
                <ComboBox x:Name="LoginComboBox" Visibility="Collapsed" SelectionChanged="LoginComboBox_SelectionChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>
