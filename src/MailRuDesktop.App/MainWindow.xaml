<Window x:Class="MailRuDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailRu Desktop"
        Icon="{StaticResource AppIcon}"
        Height="780" Width="1240"
        MinHeight="640" MinWidth="980">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MailRu Desktop"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="LoginComboBox"
                      Grid.Column="0"
                      Margin="0,0,10,0"
                      Padding="6"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      SelectionChanged="LoginComboBox_SelectionChanged"
                      ToolTip="Логин Mail.ru. Сохранённые авторизации доступны в списке."/>

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         Padding="8"
                         ToolTip="Пароль не сохраняется. Сохраняются только защищённые Windows токены."/>

            <Button x:Name="AuthenticateButton"
                    Grid.Column="2"
                    Padding="18,8"
                    Click="AuthenticateButton_Click"
                    Content="Войти"/>

            <TextBlock x:Name="AuthStatusText"
                       Grid.Column="3"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Text="Не авторизовано"/>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Почта">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RefreshFolderButton"
                                Grid.Column="0"
                                Padding="16,8"
                                Click="RefreshFolderButton_Click"
                                Content="Обновить"/>

                        <TextBlock x:Name="FolderStatusText"
                                   Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Авторизуйтесь для загрузки почты"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="6,4,6,10"
                                           FontWeight="SemiBold"
                                           Text="Папки"/>
                                <ListBox x:Name="FolderListBox"
                                         BorderThickness="0"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="FolderListBox_SelectionChanged"/>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <DataGrid x:Name="MessagesGrid"
                                  Grid.Column="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionChanged="MessagesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Width="28" Binding="{Binding UnreadMark}"/>
                                <DataGridTextColumn Header="Отправитель" Width="170" Binding="{Binding SenderDisplay}"/>
                                <DataGridTextColumn Header="Тема" Width="*" Binding="{Binding Subject}"/>
                                <DataGridTextColumn Header="Дата" Width="125" Binding="{Binding DateDisplay}"/>
                                <DataGridTextColumn Header="" Width="32" Binding="{Binding AttachmentMark}"/>
                                <DataGridTextColumn Header="" Width="32" Binding="{Binding FlagMark}"/>
                                <DataGridTextColumn Header="Размер" Width="80" Binding="{Binding SizeDisplay}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="3"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <Border Grid.Column="4"
                                BorderBrush="#D6DCE5"
                                BorderThickness="1"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedSubjectText"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="Выберите письмо"/>
                                    <TextBlock x:Name="SelectedSenderText"
                                               Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedDateText"
                                               Margin="0,3,0,0"
                                               Foreground="Gray"/>
                                    <Separator Margin="0,12,0,12"/>
                                    <TextBlock x:Name="SelectedSnippetText"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedMetaText"
                                               Margin="0,14,0,0"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="#8A5A00"
                                               TextWrapping="Wrap"
                                               Text="Полное тело письма пока не запрашивается: endpoint чтения будет следующим этапом."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="2"
                              Margin="0,10,0,0"
                              Header="Диагностика · raw JSON">
                        <TextBox x:Name="ResponseTextBox"
                                 Height="150"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"/>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Написать">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Кому"/>
                    <TextBox x:Name="ComposeToTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Тема"/>
                    <TextBox x:Name="ComposeSubjectTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button x:Name="AttachButton"
                                Padding="14,7"
                                Click="AttachButton_Click"
                                Content="Добавить вложения"/>
                        <TextBlock x:Name="AttachmentSummaryText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Вложений нет"/>
                    </StackPanel>

                    <TextBox x:Name="ComposeBodyTextBox"
                             Grid.Row="3" Grid.ColumnSpan="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"/>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SendButton"
                                Grid.Column="0"
                                Padding="22,9"
                                Click="SendButton_Click"
                                Content="Отправить"/>

                        <TextBlock x:Name="ComposeStatusText"
                                   Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
