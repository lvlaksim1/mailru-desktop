<Window x:Class="MailRuDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailRu Desktop" Height="720" Width="1080"
        MinHeight="580" MinWidth="820">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MailRu Desktop"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="LoginTextBox"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     Padding="8"
                     ToolTip="Mail.ru login"/>

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         Padding="8"
                         ToolTip="Password is kept in memory only"/>

            <Button x:Name="AuthenticateButton"
                    Grid.Column="2"
                    Padding="18,8"
                    Click="AuthenticateButton_Click"
                    Content="Войти"/>

            <TextBlock x:Name="AuthStatusText"
                       Grid.Column="3"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Text="Не авторизовано"/>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Папка / protocol view">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="FolderIdTextBox"
                                 Grid.Column="0"
                                 Padding="8"
                                 Text="0"
                                 ToolTip="Mail.ru folder numeric id"/>

                        <Button x:Name="LoadFolderButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="18,8"
                                Click="LoadFolderButton_Click"
                                Content="Загрузить папку"/>

                        <TextBlock Grid.Column="2"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Сырой A-level threads/status/smart для проверки схемы"/>
                    </Grid>

                    <TextBox x:Name="ResponseTextBox"
                             Grid.Row="1"
                             FontFamily="Consolas"
                             FontSize="13"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Написать">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Кому"/>
                    <TextBox x:Name="ComposeToTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Тема"/>
                    <TextBox x:Name="ComposeSubjectTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Padding="8"
                             Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button x:Name="AttachButton"
                                Padding="14,7"
                                Click="AttachButton_Click"
                                Content="Добавить вложения"/>
                        <TextBlock x:Name="AttachmentSummaryText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Text="Вложений нет"/>
                    </StackPanel>

                    <TextBox x:Name="ComposeBodyTextBox"
                             Grid.Row="3" Grid.ColumnSpan="2"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"/>

                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SendButton"
                                Grid.Column="0"
                                Padding="22,9"
                                Click="SendButton_Click"
                                Content="Отправить"/>

                        <TextBlock x:Name="ComposeStatusText"
                                   Grid.Column="1"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
